# Copy to .env and fill in.

# ── Server ──────────────────────────────────────────────
PORT=
# Frontend origin(s), comma-separated
CORS_ORIGIN=
FRONTEND_BASE_URL=
# Public API URL INCLUDING /api (used in email links)
API_BASE_URL=
APP_NAME=

# ── Database ────────────────────────────────────────────
MONGODB_URI=

# ── Auth: generate each with `openssl rand -hex 64` ────
SESSION_SECRET=
JWT_SECRET=
JWT_REFRESH_SECRET=
RECAPTCHA_SECRET_KEY=

# ── Encryption at rest (worry text) ─────────────────────
# 64 hex chars: `openssl rand -hex 32`. Back it up: losing it makes entries unreadable.
FIELD_ENCRYPTION_KEY=

# ── Email (MailerSend: password reset) ──────────────────
MAILERSEND_API_KEY=
MAILERSEND_FROM_EMAIL=
MAILERSEND_FROM_NAME=
MAILERSEND_TEMPLATE_RESET_PASSWORD=
MAILERSEND_TEMPLATE_SIGN_UP=
MAILERSEND_TEMPLATE_VERIFY_EMAIL=

# ── Monitoring ──────────────────────────────────────────
SENTRY_DSN=
